# Future Minds — Admissions email configuration
# Copy to .env.local only when authorised credentials
# and the official business email are available.

RESEND_API_KEY=
RESEND_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Do not commit .env.local or actual API secrets.

# PostgreSQL — configure only after selecting the provider.
# Never commit the real connection string.
DATABASE_URL=

# Authentication provider configuration is pending.
# Do not expose administrative credentials to browsers.


# Future Minds authentication — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL connection
DATABASE_URL=

# Never place privileged database or service-role
# secrets in NEXT_PUBLIC_ variables.
